# Where the Next.js server reaches the API (server-side only, never sent to the browser)
API_URL=http://localhost:4000

# Must match WEB_PROXY_SECRET in the API (lets the API trust scan locations from Vercel headers)
WEB_PROXY_SECRET=

# Portfolio demo only: the shared demo-account password, shown on /demo. Leave empty on real deployments.
DEMO_PASSWORD=
