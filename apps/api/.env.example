NODE_ENV=development
PORT=4000
# Public origin of the web app (used for CORS)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL. With Neon, use the dev branch: the "-pooler" host for DATABASE_URL and the plain host
# for DIRECT_URL (migrations). Add connect_timeout=30; Prisma's engine can time out on the TLS handshake.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/origo?sslmode=require&connect_timeout=30
#   DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/origo?sslmode=require&connect_timeout=30
# With local Docker Postgres, both are the same URL:
DATABASE_URL=postgresql://origo:origo@localhost:5432/origo?schema=public
DIRECT_URL=postgresql://origo:origo@localhost:5432/origo?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Cookies: true in production (HTTPS only)
COOKIE_SECURE=false

# Proxies in front of the API: 1 locally (Next.js dev proxy), 2 on the VM (Vercel + Caddy), 1 on Vercel
TRUST_PROXY_HOPS=1

LOG_LEVEL=debug
SENTRY_DSN=

# Redis for job queues (queue runner only): docker compose -f infra/docker-compose.dev.yml up -d redis
REDIS_URL=redis://localhost:6379

# QR codes point at the web app's verify page. Generate a signing key with: pnpm --filter @origo/api qr:keygen
VERIFY_BASE_URL=http://localhost:3000/v
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KEY_ID=k1

# Label PDFs. Runner: "queue" (BullMQ worker, needs Redis) or "inline" (built in the API after the
# response; serverless). Storage: "disk" (LABEL_EXPORT_DIR, shared with the worker) or "database".
LABEL_EXPORT_RUNNER=queue
LABEL_EXPORT_STORAGE=disk
LABEL_EXPORT_DIR=./var/label-exports
LABEL_EXPORT_TTL_HOURS=24
# Bearer secret for scheduled calls (Vercel Cron cleans up expired PDFs with the inline runner). Leave empty otherwise.
CRON_SECRET=

# Used by prisma/seed.ts only
SEED_ADMIN_EMAIL=admin@origo.local
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_DEMO_PASSWORD=change-me-demo-123

# Public verification: key for hashing scanner IPs (never stored raw), and the secret the web app
# sends with location headers. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SCAN_HASH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
WEB_PROXY_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public demo endpoints (sample packs for /demo). Only for the portfolio demo deployment.
DEMO_MODE=false

# Queue runner only: consume the queue inside the API (single-process hosts). Keep false with a separate worker.
RUN_WORKER_IN_API=false
