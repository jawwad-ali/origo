{
  "name": "@origo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file=.env\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@origo/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "@origo/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^10.78.0",
    "argon2": "~0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7",
    "prisma": "^6.19.3"
  }
}
