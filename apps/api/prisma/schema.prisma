generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's "-pooler" host): used by the running API.
  url       = env("DATABASE_URL")
  // Direct connection: used by `prisma migrate`, which needs a session the pooler can't give.
  directUrl = env("DIRECT_URL")
}

enum OrgType {
  MANUFACTURER
  DISTRIBUTOR
  WHOLESALER
  PHARMACY
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  membership Membership?
  sessions   Session[]

  @@map("users")
}

model Organization {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  type            OrgType
  status          OrgStatus @default(PENDING)
  licenseNumber   String    @map("license_number")
  city            String
  country         String    @db.Char(2)
  rejectionReason String?   @map("rejection_reason")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  products    Product[]
  batches     Batch[]
  ownedPacks  Pack[]       @relation("PackOwner")

  @@unique([country, licenseNumber])
  @@index([status, createdAt])
  @@map("organizations")
}

/// One user belongs to one organization in the MVP (unique userId).
model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("memberships")
}

enum SessionRevokeReason {
  ROTATED
  LOGOUT
  REUSE
}

/// A refresh token. Tokens rotate on every refresh; all tokens from one login share a familyId.
model Session {
  id            String               @id @default(uuid(7)) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  familyId      String               @map("family_id") @db.Uuid
  tokenHash     String               @unique @map("token_hash")
  expiresAt     DateTime             @map("expires_at")
  revokedAt     DateTime?            @map("revoked_at")
  revokedReason SessionRevokeReason? @map("revoked_reason")
  replacedById  String?              @map("replaced_by_id") @db.Uuid
  userAgent     String?              @map("user_agent")
  ip            String?
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

/// Account and admin actions. Pack history lives in the ledger (Phase 3), not here.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorOrgId  String?  @map("actor_org_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  OTHER
}

enum BatchStatus {
  ACTIVE
  RECALLED
}

enum PackStatus {
  IN_STOCK
  IN_TRANSIT
  DISPENSED
  RECALLED
}

enum LabelExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

/// A medicine a manufacturer makes. Packs are registered against its batches.
model Product {
  id                  String     @id @default(uuid(7)) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  name                String
  genericName         String     @map("generic_name")
  strength            String
  dosageForm          DosageForm @map("dosage_form")
  packSize            String     @map("pack_size")
  storageInstructions String     @map("storage_instructions")
  createdById         String     @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches      Batch[]

  @@unique([organizationId, name, strength, dosageForm])
  @@index([organizationId, createdAt])
  @@map("products")
}

model Batch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  batchNumber    String      @map("batch_number")
  manufacturedOn DateTime    @map("manufactured_on") @db.Date
  expiresOn      DateTime    @map("expires_on") @db.Date
  status         BatchStatus @default(ACTIVE)
  packCount      Int         @map("pack_count")
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  packs        Pack[]
  labelExports LabelExport[]

  @@unique([organizationId, batchNumber])
  @@index([productId])
  @@index([organizationId, createdAt])
  @@map("batches")
}

/// One physical pack. publicId (e.g. MED-2026-000123) is printed in the QR code; serial comes from pack_serial_seq.
model Pack {
  id                String     @id @default(uuid(7)) @db.Uuid
  publicId          String     @unique @map("public_id")
  serial            Int        @unique
  batchId           String     @map("batch_id") @db.Uuid
  currentOwnerOrgId String     @map("current_owner_org_id") @db.Uuid
  status            PackStatus @default(IN_STOCK)
  createdAt         DateTime   @default(now()) @map("created_at")

  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  currentOwner Organization @relation("PackOwner", fields: [currentOwnerOrgId], references: [id], onDelete: Restrict)

  @@index([batchId, serial])
  @@index([currentOwnerOrgId, status])
  @@map("packs")
}

/// A print-ready PDF of a batch's QR labels, built by the worker and kept for a limited time.
model LabelExport {
  id             String            @id @default(uuid(7)) @db.Uuid
  batchId        String            @map("batch_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  requestedById  String            @map("requested_by_id") @db.Uuid
  status         LabelExportStatus @default(QUEUED)
  labelCount     Int               @map("label_count")
  filePath       String?           @map("file_path")
  fileSizeBytes  Int?              @map("file_size_bytes")
  error          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  expiresAt      DateTime?         @map("expires_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([status, expiresAt])
  @@map("label_exports")
}
