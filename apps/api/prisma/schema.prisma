generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's "-pooler" host): used by the running API.
  url       = env("DATABASE_URL")
  // Direct connection: used by `prisma migrate`, which needs a session the pooler can't give.
  directUrl = env("DIRECT_URL")
}

enum OrgType {
  MANUFACTURER
  DISTRIBUTOR
  WHOLESALER
  PHARMACY
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  membership Membership?
  sessions   Session[]

  @@map("users")
}

model Organization {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  type            OrgType
  status          OrgStatus @default(PENDING)
  licenseNumber   String    @map("license_number")
  city            String
  country         String    @db.Char(2)
  rejectionReason String?   @map("rejection_reason")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships  Membership[]
  products     Product[]
  batches      Batch[]
  ownedPacks   Pack[]       @relation("PackOwner")
  transfersOut Transfer[]   @relation("TransferFrom")
  transfersIn  Transfer[]   @relation("TransferTo")

  @@unique([country, licenseNumber])
  @@index([status, createdAt])
  @@map("organizations")
}

/// One user belongs to one organization in the MVP (unique userId).
model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("memberships")
}

enum SessionRevokeReason {
  ROTATED
  LOGOUT
  REUSE
}

/// A refresh token. Tokens rotate on every refresh; all tokens from one login share a familyId.
model Session {
  id            String               @id @default(uuid(7)) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  familyId      String               @map("family_id") @db.Uuid
  tokenHash     String               @unique @map("token_hash")
  expiresAt     DateTime             @map("expires_at")
  revokedAt     DateTime?            @map("revoked_at")
  revokedReason SessionRevokeReason? @map("revoked_reason")
  replacedById  String?              @map("replaced_by_id") @db.Uuid
  userAgent     String?              @map("user_agent")
  ip            String?
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

/// Account and admin actions. Pack history lives in the ledger (Phase 3), not here.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorOrgId  String?  @map("actor_org_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  OTHER
}

enum BatchStatus {
  ACTIVE
  RECALLED
}

enum PackStatus {
  IN_STOCK
  IN_TRANSIT
  DISPENSED
  RECALLED
}

enum LabelExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

/// A medicine a manufacturer makes. Packs are registered against its batches.
model Product {
  id                  String     @id @default(uuid(7)) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  name                String
  genericName         String     @map("generic_name")
  strength            String
  dosageForm          DosageForm @map("dosage_form")
  packSize            String     @map("pack_size")
  storageInstructions String     @map("storage_instructions")
  createdById         String     @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches      Batch[]

  @@unique([organizationId, name, strength, dosageForm])
  @@index([organizationId, createdAt])
  @@map("products")
}

model Batch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  batchNumber    String      @map("batch_number")
  manufacturedOn DateTime    @map("manufactured_on") @db.Date
  expiresOn      DateTime    @map("expires_on") @db.Date
  status         BatchStatus @default(ACTIVE)
  packCount      Int         @map("pack_count")
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  packs        Pack[]
  labelExports LabelExport[]

  @@unique([organizationId, batchNumber])
  @@index([productId])
  @@index([organizationId, createdAt])
  @@map("batches")
}

/// One physical pack. publicId (e.g. MED-2026-000123) is printed in the QR code; serial comes from pack_serial_seq.
model Pack {
  id                String     @id @default(uuid(7)) @db.Uuid
  publicId          String     @unique @map("public_id")
  serial            Int        @unique
  batchId           String     @map("batch_id") @db.Uuid
  currentOwnerOrgId String     @map("current_owner_org_id") @db.Uuid
  status            PackStatus @default(IN_STOCK)
  createdAt         DateTime   @default(now()) @map("created_at")

  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  currentOwner  Organization   @relation("PackOwner", fields: [currentOwnerOrgId], references: [id], onDelete: Restrict)
  transferItems TransferItem[]
  ledgerEvents  LedgerEvent[]
  scans         Scan[]

  @@index([batchId, serial])
  @@index([currentOwnerOrgId, status])
  @@map("packs")
}

/// A print-ready PDF of a batch's QR labels, built by the worker and kept for a limited time.
model LabelExport {
  id             String            @id @default(uuid(7)) @db.Uuid
  batchId        String            @map("batch_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  requestedById  String            @map("requested_by_id") @db.Uuid
  status         LabelExportStatus @default(QUEUED)
  labelCount     Int               @map("label_count")
  filePath       String?           @map("file_path")
  fileSizeBytes  Int?              @map("file_size_bytes")
  error          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  expiresAt      DateTime?         @map("expires_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([status, expiresAt])
  @@map("label_exports")
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum LedgerEventType {
  REGISTERED
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  DISPENSED
}

/// A handover of packs from one organization to another. Ownership moves only when the receiver accepts.
model Transfer {
  id              String         @id @default(uuid(7)) @db.Uuid
  reference       String         @unique
  fromOrgId       String         @map("from_org_id") @db.Uuid
  toOrgId         String         @map("to_org_id") @db.Uuid
  status          TransferStatus @default(PENDING)
  packCount       Int            @map("pack_count")
  note            String?
  rejectionReason String?        @map("rejection_reason")
  idempotencyKey  String?        @map("idempotency_key")
  createdById     String         @map("created_by_id") @db.Uuid
  respondedById   String?        @map("responded_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  respondedAt     DateTime?      @map("responded_at")

  fromOrg Organization   @relation("TransferFrom", fields: [fromOrgId], references: [id], onDelete: Restrict)
  toOrg   Organization   @relation("TransferTo", fields: [toOrgId], references: [id], onDelete: Restrict)
  items   TransferItem[]

  @@unique([fromOrgId, idempotencyKey])
  @@index([fromOrgId, status, createdAt])
  @@index([toOrgId, status, createdAt])
  @@map("transfers")
}

/// One pack in a transfer. is_open mirrors "transfer is pending" so a partial unique index can stop
/// the same pack being in two open transfers at once (see the migration).
model TransferItem {
  id         String  @id @default(uuid(7)) @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  packId     String  @map("pack_id") @db.Uuid
  batchId    String  @map("batch_id") @db.Uuid
  isOpen     Boolean @default(true) @map("is_open")

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  pack     Pack     @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@unique([transferId, packId])
  @@index([packId])
  @@index([transferId, batchId])
  @@map("transfer_items")
}

/// Append-only, hash-chained history of each pack. A database trigger rejects UPDATE and DELETE.
/// hash = SHA-256 over the previous hash and this event's fields; seq starts at 1 per pack.
model LedgerEvent {
  id                String          @id @default(uuid(7)) @db.Uuid
  packId            String          @map("pack_id") @db.Uuid
  seq               Int
  type              LedgerEventType
  actorOrgId        String          @map("actor_org_id") @db.Uuid
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  counterpartyOrgId String?         @map("counterparty_org_id") @db.Uuid
  transferId        String?         @map("transfer_id") @db.Uuid
  prevHash          String          @map("prev_hash") @db.Char(64)
  hash              String          @db.Char(64)
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)

  pack Pack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@unique([packId, seq])
  @@index([transferId])
  @@map("ledger_events")
}

enum VerificationVerdict {
  VERIFIED
  WARNING
  NOT_RECOGNIZED
}

/// One public verification of a pack. The visitor's IP is never stored, only a keyed hash of it,
/// enough to tell repeat scans from new devices.
model Scan {
  id             String              @id @default(uuid(7)) @db.Uuid
  packId         String              @map("pack_id") @db.Uuid
  verdict        VerificationVerdict
  signatureValid Boolean             @map("signature_valid")
  deviceHash     String?             @map("device_hash") @db.Char(64)
  city           String?
  country        String?             @db.Char(2)
  scannedAt      DateTime            @default(now()) @map("scanned_at")

  pack Pack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([packId, scannedAt])
  @@map("scans")
}
