# Copy to infra/.env.production ON THE VM (never commit the real file).

# Caddy
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# API
WEB_ORIGIN=https://your-app.vercel.app
# Neon "main" branch. Pooled host for the app, direct host for migrations (deploy.sh runs them).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/origo?sslmode=require&connect_timeout=30
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/origo?sslmode=require&connect_timeout=30
JWT_ACCESS_SECRET=generate-a-48-byte-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info
SENTRY_DSN=

# QR codes: generate a key once with `pnpm --filter @origo/api qr:keygen`. Never change the key
# without adding the old one for verification, or printed labels stop verifying.
VERIFY_BASE_URL=https://your-app.vercel.app/v
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KEY_ID=k1
LABEL_EXPORT_TTL_HOURS=24
